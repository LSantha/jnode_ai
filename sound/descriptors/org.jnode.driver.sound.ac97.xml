<!DOCTYPE plugin SYSTEM "jnode.dtd">

<plugin id="org.jnode.driver.sound.ac97"
        name="JNode Intel AC'97 audio driver"
        version="@VERSION@"
        license-name="lgpl"
        provider-name="JNode.org">

  <requires>
    <import plugin="org.jnode.driver.bus.pci"/>
  </requires>

  <runtime>
    <library name="jnode-sound.jar">
      <export name="org.jnode.driver.sound.ac97.*"/>
    </library>
  </runtime>

  <extension point="org.jnode.driver.mappers">
    <!-- Intel ICH (82801AA) and ICH0 (82801AB) AC'97 audio controller.
         Later ICH parts that still implement AC'97 report the same ids.
         Equivalent controllers of other vendors (SiS, AMD) can be added
         here; the register layout is identical, only the ids differ. -->
    <mapper id="8086:2415" name="Intel ICH AC'97"
            driver-class="org.jnode.driver.sound.ac97.AC97Driver"
            class="org.jnode.driver.bus.pci.PCIDeviceToDriverMapper"/>
  </extension>

  <extension point="org.jnode.security.permissions">
    <permission class="org.jnode.system.resource.ResourcePermission" name="ioports"/>
  </extension>

</plugin>
