<!DOCTYPE plugin SYSTEM "jnode.dtd">

<plugin id="org.jnode.driver.sound.ac97.command"
        name="JNode AC'97 commands"
        version="@VERSION@"
        license-name="lgpl"
        provider-name="JNode.org">

  <requires>
    <import plugin="org.jnode.driver.sound.ac97"/>
    <import plugin="org.jnode.shell.help"/>
  </requires>

  <runtime>
    <library name="jnode-sound.jar">
      <export name="org.jnode.driver.sound.ac97.command.*"/>
    </library>
  </runtime>

  <extension point="org.jnode.shell.aliases">
    <alias name="ac97play" class="org.jnode.driver.sound.ac97.command.AC97PlayCommand"/>
  </extension>

  <extension point="org.jnode.shell.syntaxes">
    <syntax alias="ac97play">
      <sequence description="Play a tone with a given frequency and duration">
        <argument argLabel="frequency" description="tone frequency in Hz"/>
        <argument argLabel="duration" description="duration in milliseconds"/>
      </sequence>
    </syntax>
  </extension>

</plugin>
