<testSet title="mkdir command tests">
    <plugin id="org.jnode.command.file"/>
    <plugin id="org.jnode.shell.bjorne" class="org.jnode.test.shell.bjorne.BjornePseudoPlugin"/>
    <testSpec title="single-create" command="run" runMode="AS_SCRIPT" rc="0">
        <script>#!bjorne
                mkdir @TEMP_DIR@/a
        </script>
        <file name="a" directory="true"/>
    </testSpec>
    <testSpec title="nested-create-with-parents-short" command="run" runMode="AS_SCRIPT" rc="0">
        <script>#!bjorne
                mkdir -p @TEMP_DIR@/a/b/c
        </script>
        <file name="a/b/c" directory="true"/>
    </testSpec>
    <testSpec title="nested-create-with-parents-long" command="run" runMode="AS_SCRIPT" rc="0">
        <script>#!bjorne
                mkdir --parents @TEMP_DIR@/a/b/c
        </script>
        <file name="a/b/c" directory="true"/>
    </testSpec>
    <testSpec title="nested-create-without-parents-fails" command="run" runMode="AS_SCRIPT" rc="1">
        <script>#!bjorne
                mkdir @TEMP_DIR@/a/b/c
        </script>
    </testSpec>
    <testSpec title="parents-no-error-if-existing" command="run" runMode="AS_SCRIPT" rc="0">
        <script>#!bjorne
                mkdir @TEMP_DIR@/a
                mkdir -p @TEMP_DIR@/a
        </script>
        <file name="a" directory="true"/>
    </testSpec>
</testSet>
