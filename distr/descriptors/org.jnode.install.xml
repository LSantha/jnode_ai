<!DOCTYPE plugin SYSTEM "jnode.dtd">

<plugin id="org.jnode.install" 
        name="JNode Installation Program"
        version="@VERSION@"
        provider-name="JNode.org"
        license-name="lgpl">
        
  <requires>
    <import plugin="org.jnode.fs"/>
    <import plugin="org.jnode.fs.jfat.command"/>
    <import plugin="org.jnode.log4j"/>
    <import plugin="org.jnode.shell"/>
    <import plugin="org.jnode.shell.syntax"/>
  </requires>
        
  <runtime>
    <library name="jnode-distr.jar">
      <export name="org.jnode.install.*"/>
      <export name="org.jnode.install.action.*"/>
      <export name="org.jnode.install.cmdline.*"/>
      </library>
  </runtime>

  <extension point="org.jnode.shell.aliases">
    <alias name="install" class="org.jnode.install.cmdline.InstallCommand"/>
  </extension>

  <extension point="org.jnode.shell.syntaxes">
    <syntax alias="install">
      <empty description="install JNode onto a disk device"/>
    </syntax>
  </extension>

  <extension point="org.jnode.security.permissions">
    <permission class="java.io.FilePermission" name="&lt;&lt;ALL FILES&gt;&gt;" actions="read,write,delete"/>
  </extension>

</plugin>
