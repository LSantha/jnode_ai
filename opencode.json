{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openrouter/cohere/north-mini-code:free",
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": {
          "gh issue *": "allow",
          "gh search *": "allow"
        }
      }
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/*": "allow"
    }
  }
}